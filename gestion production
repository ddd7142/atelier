        // MODIFICATION/AJOUT START: Attacher listener pour le nouveau bouton
        const btnUpdateAnnualCP = document.getElementById('btnUpdateAnnualCP');
        if (btnUpdateAnnualCP && !btnUpdateAnnualCP.hasAttribute('data-listener-attached-annualcp')) {
