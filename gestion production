    // --- DEBUT : Gestion des Ordres de Fabrication (OFs) ---
    const DB_KEY_OFS = 'atelier_OFsData';
    let ofsData = []; // Sera initialisé par loadOFs()
    let ofEditMode = false;
    let currentOFFilters = { searchText: '', status: '', machine: '' };
    let ofStatusChartInstance = null;

    function loadOFs() {
        const data = localStorage.getItem(DB_KEY_OFS);
        ofsData = data ? JSON.parse(data) : [];
        return ofsData;
    }

    function saveOFs() {
        localStorage.setItem(DB_KEY_OFS, JSON.stringify(ofsData));
    }

    function updateOFsSummary() {
        const summaryEl = document.getElementById('ofsSummary');
        const qualityIndicatorEl = document.getElementById('globalQualityIndicator');

        if (summaryEl) {
            const enCours = ofsData.filter(of => of.status === 'En cours').length;
            const planifies = ofsData.filter(of => of.status === 'Planifié').length;
            const nonTermines = enCours + planifies;

            // Chercher le noeud texte existant pour le mettre à jour, sinon le créer
            const summaryTextNode = Array.from(summaryEl.childNodes).find(node => node.nodeType === Node.TEXT_NODE && node.textContent.includes("OF(s) enregistré(s)"));
            if(summaryTextNode) {
                summaryTextNode.textContent = ` ${ofsData.length} OF(s) enregistré(s), dont ${nonTermines} non terminé(s). `;
            } else {
                const firstChildIcon = summaryEl.querySelector('i');
                summaryEl.innerHTML = ''; // Vider pour reconstruire
                if(firstChildIcon) summaryEl.appendChild(firstChildIcon); // Réinsérer l'icône
                summaryEl.appendChild(document.createTextNode(` ${ofsData.length} OF(s) enregistré(s), dont ${nonTermines} non terminé(s). `));
                if(qualityIndicatorEl) summaryEl.appendChild(qualityIndicatorEl); // Réinsérer l'indicateur de qualité s'il existe
            }
        }

        if (qualityIndicatorEl) {
            let totalProducedAllOFs = 0;
            let totalRebutsAllOFs = 0;
            ofsData.forEach(of => {
                totalProducedAllOFs += (of.produced || 0);
                totalRebutsAllOFs += (of.rebuts || 0);
            });
            let globalTauxRebut = 0;
            if (totalProducedAllOFs > 0) { // Éviter division par zéro
                globalTauxRebut = parseFloat(((totalRebutsAllOFs / totalProducedAllOFs) * 100).toFixed(2));
            }
            let color = getCssVar('--success-color');
            if (globalTauxRebut > 5) color = getCssVar('--danger-color');
            else if (globalTauxRebut > 2) color = getCssVar('--warning-color');
            qualityIndicatorEl.innerHTML = `Qualité Globale (OFs) - Taux de Rebut: <span style="color:${color};">${globalTauxRebut}%</span>`;
        }
        updateGlobalStatsBar(); // Mettre à jour la barre de stats globale qui dépend aussi des OFs
    }

    function applyOFsFilters() {
        currentOFFilters.searchText = document.getElementById('filterOFSearch').value.toUpperCase();
        currentOFFilters.status = document.getElementById('filterOFStatus').value;
        currentOFFilters.machine = document.getElementById('filterOFMachine').value;
        renderOFsTable(); // Cela va aussi mettre à jour le graphique via son appel dans renderOFsTable
    }

    function resetOFsFilters() {
        document.getElementById('filterOFSearch').value = '';
        document.getElementById('filterOFStatus').value = '';
        document.getElementById('filterOFMachine').value = '';
        currentOFFilters = { searchText: '', status: '', machine: '' }; // Réinitialiser l'objet filtre
        renderOFsTable(); // Mettre à jour la table et le graphique
        showToast("Filtres OFs réinitialisés.", "info");
    }

    function updateOFStatusChart() {
        const chartCanvas = document.getElementById('ofStatusChart');
        if (!chartCanvas) return;

        if (ofStatusChartInstance) {
            ofStatusChartInstance.destroy();
        }

        const statusCounts = { 'Planifié': 0, 'En cours': 0, 'Terminé': 0 };
        
        // Utiliser les OFs filtrés pour le graphique si des filtres sont actifs, sinon tous les OFs
        let dataForChart = ofsData;
        // Appliquer les filtres au dataset du graphique
        if (currentOFFilters.searchText || currentOFFilters.status || currentOFFilters.machine) {
            dataForChart = ofsData.filter(of => {
                let match = true;
                if (currentOFFilters.status && of.status !== currentOFFilters.status) match = false;
                if (currentOFFilters.machine && of.machine !== currentOFFilters.machine) match = false;
                if (currentOFFilters.searchText && 
                    !(of.orderNumber.toUpperCase().includes(currentOFFilters.searchText) || 
                      of.product.toUpperCase().includes(currentOFFilters.searchText))) {
                    match = false;
                }
                return match;
            });
        }
        
        if (dataForChart && Array.isArray(dataForChart)) {
            dataForChart.forEach(of => {
                if (statusCounts.hasOwnProperty(of.status)) {
                    statusCounts[of.status]++;
                }
            });
        }

        ofStatusChartInstance = new Chart(chartCanvas.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: Object.keys(statusCounts),
                datasets: [{
                    label: 'Nombre d\'OFs',
                    data: Object.values(statusCounts),
                    backgroundColor: [
                        getCssVar('--warning-color'), // Planifié (jaune/orange)
                        getCssVar('--primary-color'),  // En cours (bleu/gris acier)
                        getCssVar('--success-color')  // Terminé (vert)
                    ],
                    borderColor: getCssVar('--card-bg-color'), // Bordure de la couleur du fond de la carte
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, animation: {duration: 0},
                plugins: { legend: { position: 'bottom', labels: { color: getCssVar('--text-color') } } }
            }
        });
    }


    function renderOFsTable() {
        const tableBody = document.getElementById('ofsTableBody');
        if (!tableBody) return;
        tableBody.innerHTML = ''; // Vider le tableau

        // Filtrer les OFs
        let filteredOFs = [...ofsData];
        if (currentOFFilters.status) {
            filteredOFs = filteredOFs.filter(of => of.status === currentOFFilters.status);
        }
        if (currentOFFilters.machine) {
            filteredOFs = filteredOFs.filter(of => of.machine === currentOFFilters.machine);
        }
        if (currentOFFilters.searchText) {
            filteredOFs = filteredOFs.filter(of =>
                of.orderNumber.toUpperCase().includes(currentOFFilters.searchText) ||
                of.product.toUpperCase().includes(currentOFFilters.searchText)
            );
        }

        // Trier les OFs : d'abord non terminés, puis par ID (plus récent en premier)
        const ofsToDisplay = filteredOFs.sort((a, b) => {
            if (a.status === 'Terminé' && b.status !== 'Terminé') return 1;
            if (a.status !== 'Terminé' && b.status === 'Terminé') return -1;
            // Si les deux sont terminés ou les deux ne le sont pas, trier par ID
            return parseInt(b.id) - parseInt(a.id); // ID est une string "timestamp_random"
        });

        if (ofsToDisplay.length === 0) {
            const tr = tableBody.insertRow();
            const td = tr.insertCell();
            td.colSpan = 11; // Ajuster si le nombre de colonnes change
            td.textContent = "Aucun OF ne correspond aux filtres actuels.";
            td.style.textAlign = "center";
            td.style.fontStyle = "italic";
            updateOFStatusChart(); // Mettre à jour le graphique même s'il n'y a pas de données
            return;
        }

        ofsToDisplay.forEach(of => {
            const tr = tableBody.insertRow();
            const qteBonne = Math.max(0, (of.produced || 0) - (of.rebuts || 0));
            const progress = of.quantity > 0 ? Math.round((qteBonne / of.quantity) * 100) : 0;
            const tauxRebut = (of.produced || 0) > 0 ? parseFloat(((of.rebuts || 0) / (of.produced || 0) * 100).toFixed(2)) : 0;

            let statusColorVar = '--success-color'; // Vert par défaut (proche de 100%)
            if (of.status === 'Terminé') statusColorVar = '--blue-color'; // Bleu si terminé
            else if (of.status === 'Planifié') statusColorVar = '--secondary-color'; // Gris si planifié
            else if (progress < 50) statusColorVar = '--danger-color'; // Rouge si < 50%
            else if (progress < 90) statusColorVar = '--warning-color'; // Jaune/Orange si < 90%

            tr.insertCell().innerHTML = `<span style="color:var(${statusColorVar}); font-weight:bold;">${of.status}</span>`;
            tr.insertCell().textContent = of.orderNumber;
            tr.insertCell().textContent = of.machine;
            tr.insertCell().textContent = of.product;
            tr.insertCell().textContent = of.quantity;

            // Cellule Quantité Produite
            const producedCell = tr.insertCell();
            producedCell.className = `produced-cell ${ofEditMode && isAdminMode && of.status !== 'Terminé' ? 'editable' : ''}`;
            if (ofEditMode && isAdminMode && of.status !== 'Terminé') {
                producedCell.innerHTML = `<input type="number" class="of-produced-input admin-only-input" value="${of.produced || 0}" min="0" data-of-id-prod="${of.id}" style="width:70px; text-align:center;" ${isAdminMode?'':'disabled'}>`;
            } else {
                producedCell.textContent = of.produced || 0;
            }

            // Cellule Rebuts
            const rebutsCell = tr.insertCell();
            rebutsCell.className = `rebuts-cell ${ofEditMode && isAdminMode && of.status !== 'Terminé' ? 'editable' : ''}`;
            if (ofEditMode && isAdminMode && of.status !== 'Terminé') {
                rebutsCell.innerHTML = `<input type="number" class="of-rebuts-input admin-only-input" value="${of.rebuts || 0}" min="0" data-of-id-rebuts="${of.id}" style="width:70px; text-align:center;" ${isAdminMode?'':'disabled'}>`;
            } else {
                rebutsCell.textContent = of.rebuts || 0;
            }

            tr.insertCell().innerHTML = `<span style="color:var(${statusColorVar}); font-weight:bold;">${progress}%</span>`;

            // Taux de Rebut
            const tauxRebutCell = tr.insertCell();
            let tauxRebutColor = getCssVar('--success-color');
            if (tauxRebut > 5) tauxRebutColor = getCssVar('--danger-color');
            else if (tauxRebut > 2) tauxRebutColor = getCssVar('--warning-color');
            tauxRebutCell.innerHTML = `<span style="color:${tauxRebutColor}; font-weight:bold;">${tauxRebut}%</span>`;

            // Cellule Édition/Sauvegarde
            const editCell = tr.insertCell();
            editCell.classList.add('admin-only-cell');
            editCell.style.textAlign = 'center';
            if (ofEditMode && isAdminMode && of.status !== 'Terminé') {
                const saveBtn = document.createElement('button');
                saveBtn.innerHTML = '<i class="fas fa-save"></i>';
                saveBtn.title = 'Sauvegarder Qtés';
                saveBtn.style.fontSize="0.8em"; saveBtn.style.padding="4px 8px"; saveBtn.style.backgroundColor=getCssVar('--success-color'); saveBtn.style.color=getCssVar('--text-light-color'); saveBtn.style.border="none"; saveBtn.style.borderRadius="var(--border-radius-sm)"; saveBtn.style.cursor="pointer";
                saveBtn.onclick = () => saveOFQuantities(of.id);
                editCell.appendChild(saveBtn);
            } else {
                 editCell.innerHTML = (of.status === 'Terminé') ? '<i class="fas fa-check-circle" style="color:var(--success-color); font-size:1.2em;"></i>' : '-';
            }

            // Cellule Action (Supprimer)
            const actionCell = tr.insertCell();
            actionCell.classList.add('admin-only-cell');
            const deleteBtn = document.createElement('button');
            deleteBtn.className = 'supprimer-btn'; // Classe existante pour le style
            deleteBtn.innerHTML = '<i class="fas fa-trash"></i>';
            deleteBtn.title = "Supprimer l'OF";
            deleteBtn.onclick = () => deleteOF(of.id);
            actionCell.appendChild(deleteBtn);
        });
        applyOFsAccessControls(); // S'assurer que les contrôles admin sont bien appliqués après le rendu
        updateOFStatusChart(); // Mettre à jour le graphique après avoir rendu la table
    }

    function toggleOFEditMode() {
        if (!isAdminMode) {
            showToast("Mode Administrateur requis.", "warning");
            return;
        }
        ofEditMode = !ofEditMode;
        const btn = document.getElementById('toggleOFEditModeBtn');
        if (btn) {
            btn.innerHTML = ofEditMode ? '<i class="fas fa-eye"></i> Mode Vue' : '<i class="fas fa-edit"></i> Modifier Qtés';
            if(ofEditMode) {
                btn.classList.add('admin-active'); // Pourrait utiliser le style .admin-active
                btn.style.backgroundColor = getCssVar('--success-color');
            } else {
                btn.classList.remove('admin-active');
                btn.style.backgroundColor = getCssVar('--secondary-color');
            }
        }
        renderOFsTable(); // Re-rendre la table pour afficher/masquer les inputs
    }

    function saveOFQuantities(ofId) {
        if (!isAdminMode) { showToast("Mode Administrateur requis.", "warning"); return; }
        const producedInputElement = document.querySelector(`input.of-produced-input[data-of-id-prod="${ofId}"]`);
        const rebutsInputElement = document.querySelector(`input.of-rebuts-input[data-of-id-rebuts="${ofId}"]`);
        if (!producedInputElement || !rebutsInputElement) { console.error("Inputs non trouvés pour OF ID:", ofId); return; }
        const newProduced = parseInt(producedInputElement.value, 10);
        const newRebuts = parseInt(rebutsInputElement.value, 10);
        const ofIndex = ofsData.findIndex(o => o.id === ofId);
        if (ofIndex === -1) { console.error("OF non trouvé:", ofId); return; }
        const of = ofsData[ofIndex];
        if (isNaN(newProduced) || newProduced < 0) { showToast("Qté produite invalide.", "error"); producedInputElement.value = of.produced || 0; return; }
        if (isNaN(newRebuts) || newRebuts < 0) { showToast("Qté rebutée invalide.", "error"); rebutsInputElement.value = of.rebuts || 0; return; }
        if (newRebuts > newProduced) { showToast("Rebuts ne peuvent excéder la qté produite.", "error"); rebutsInputElement.value = of.rebuts || 0; return; }
        ofsData[ofIndex].produced = newProduced;
        ofsData[ofIndex].rebuts = newRebuts;
        // Mettre à jour le statut de l'OF
        const qteBonne = newProduced - newRebuts;
        if (qteBonne >= of.quantity) ofsData[ofIndex].status = 'Terminé';
        else if (newProduced > 0) ofsData[ofIndex].status = 'En cours';
        else ofsData[ofIndex].status = 'Planifié'; // Si produit = 0, revient à Planifié
        saveOFs();
        showToast(`OF ${of.orderNumber} mis à jour.`, "success");
        renderOFsTable(); // Re-rendre pour refléter les changements et le statut
        updateOFsSummary();
    }

    function deleteOF(ofId) {
        if (!isAdminMode) { showToast("Mode Administrateur requis.", "warning"); return; }
        const ofToDelete = ofsData.find(o => o.id === ofId);
        if (confirm(`Supprimer l'OF ${ofToDelete ? ofToDelete.orderNumber : ''} ? Cette action est irréversible.`)) {
            ofsData = ofsData.filter(of => of.id !== ofId);
            saveOFs();
            showToast(`OF ${ofToDelete ? ofToDelete.orderNumber : ''} supprimé.`, "success");
            renderOFsTable(); // Met à jour la table et le graphique
            updateOFsSummary();
        }
    }

    function viderTousOFs() {
        if (!isAdminMode) { showToast("Mode Administrateur requis.", "warning"); return; }
        if (confirm("Supprimer TOUS les Ordres de Fabrication ? Cette action est irréversible.")) {
            ofsData = [];
            saveOFs();
            showToast("Tous les OFs ont été supprimés.", "success");
            renderOFsTable(); // Met à jour la table et le graphique
            updateOFsSummary();
        }
    }

    function applyOFsAccessControls() {
        // Gérer la visibilité des boutons et colonnes admin
        document.querySelectorAll('#ofsTable .supprimer-btn').forEach(btn => btn.style.display = isAdminMode ? 'inline-block' : 'none');
        document.querySelectorAll('#ofsTable th.admin-only-header, #ofsTable td.admin-only-cell').forEach(cell => cell.style.display = isAdminMode ? '' : 'none');
        // Boutons de formulaire et d'action globaux
        document.querySelectorAll('#ofForm button[type="submit"].admin-only').forEach(btn => btn.style.display = isAdminMode ? 'inline-flex' : 'none');
        document.querySelectorAll('#viderTousOFs.admin-only').forEach(btn => btn.style.display = isAdminMode ? 'inline-flex' : 'none');
        document.querySelectorAll('#ofs .excel-import-area.admin-only').forEach(div => div.style.display = isAdminMode ? 'flex' : 'none'); // Pour l'import OF
        
        // Gérer les inputs dans la table (pour le mode édition)
        document.querySelectorAll('#ofsTable input.of-produced-input, #ofsTable input.of-rebuts-input').forEach(input => {
            input.disabled = !isAdminMode || !ofEditMode || input.closest('tr').querySelector('span[style*="--blue-color"]') !== null; // Désactiver si OF Terminé
             if(input.disabled) input.classList.add('admin-only-input'); else input.classList.remove('admin-only-input');
        });

        // Gérer le bouton de bascule du mode édition
        const toggleBtn = document.getElementById('toggleOFEditModeBtn');
        if (toggleBtn) {
            toggleBtn.style.display = isAdminMode ? 'inline-flex' : 'none';
            // Si on désactive le mode admin alors que le mode édition OF était actif, le désactiver aussi
            if (!isAdminMode && ofEditMode) {
                ofEditMode = false; // Réinitialiser l'état
                toggleBtn.innerHTML = '<i class="fas fa-edit"></i> Mode Vue';
                toggleBtn.classList.remove('admin-active');
                toggleBtn.style.backgroundColor = getCssVar('--secondary-color');
                renderOFsTable(); // Re-rendre la table pour que les inputs disparaissent
            }
        }
    }

    function initOFsSection() {
        const form = document.getElementById('ofForm');
        if (form && !form.hasAttribute('data-listener-attached-of')) {
            form.addEventListener('submit', function(event) {
                event.preventDefault();
                if (!isAdminMode) { showToast("Mode Administrateur requis.", "warning"); return; }
                const newOF = {
                    id: Date.now().toString() + "_" + Math.random().toString(36).substr(2, 5), // ID plus unique
                    orderNumber: this.elements.ofOrderNumber.value, machine: this.elements.ofMachine.value,
                    product: this.elements.ofProduct.value, quantity: parseInt(this.elements.ofQuantity.value, 10),
                    produced: 0, rebuts: 0, status: 'Planifié'
                };
                if(isNaN(newOF.quantity) || newOF.quantity <=0) { showToast("Qté prévue doit être un nombre positif.", "error"); return; }
                ofsData.push(newOF); saveOFs(); showToast(`OF ${newOF.orderNumber} ajouté.`, "success");
                renderOFsTable(); updateOFsSummary(); updateGlobalStatsBar(); this.reset();
            });
            form.setAttribute('data-listener-attached-of', 'true');
        }
        const viderBtn = document.getElementById('viderTousOFs');
        if (viderBtn && !viderBtn.hasAttribute('data-listener-attached-ofvider')) {
            viderBtn.addEventListener('click', viderTousOFs);
            viderBtn.setAttribute('data-listener-attached-ofvider', 'true');
        }
        // Listeners pour les filtres (input pour recherche, change pour selects)
        const filterSearch = document.getElementById('filterOFSearch');
        if(filterSearch && !filterSearch.hasAttribute('data-listener-attached-filterS')){
            filterSearch.addEventListener('input', applyOFsFilters);
            filterSearch.setAttribute('data-listener-attached-filterS', 'true');
        }
        const filterStatus = document.getElementById('filterOFStatus');
         if(filterStatus && !filterStatus.hasAttribute('data-listener-attached-filterSt')){
            filterStatus.addEventListener('change', applyOFsFilters);
            filterStatus.setAttribute('data-listener-attached-filterSt', 'true');
        }
        const filterMachine = document.getElementById('filterOFMachine');
        if(filterMachine && !filterMachine.hasAttribute('data-listener-attached-filterM')){
            filterMachine.addEventListener('change', applyOFsFilters);
            filterMachine.setAttribute('data-listener-attached-filterM', 'true');
        }
        
        // Listener pour l'import Excel des OFs
        const ofExcelImportBtn = document.getElementById('importOFsFromExcelBtn');
        const ofExcelFileInput = document.getElementById('ofExcelFile');
        if (ofExcelImportBtn && ofExcelFileInput && !ofExcelImportBtn.hasAttribute('data-listener-attached-ofexcel')) {
            ofExcelImportBtn.addEventListener('click', () => {
                if (ofExcelFileInput.files.length > 0) {
                    handleOFExcelImport({ target: ofExcelFileInput });
                } else {
                    showToast("Veuillez d'abord sélectionner un fichier Excel.", "warning");
                }
            });
            ofExcelImportBtn.setAttribute('data-listener-attached-ofexcel', 'true');
        }


        loadOFs(); renderOFsTable(); updateOFsSummary(); applyOFsAccessControls(); // Important de charger d'abord
        applyOFsFilters(); // Appliquer filtres initiaux (qui sont vides par défaut) pour lancer updateOFStatusChart
    }

    function handleOFExcelImport(event) {
        if (!isAdminMode) { showToast("Mode Administrateur requis.", "warning"); return; }
        const file = event.target.files[0];
        if (!file) { showToast("Aucun fichier sélectionné.", "info"); return; }

        const reader = new FileReader();
        reader.onload = function(e_reader) {
            const data = e_reader.target.result;
            try {
                const workbook = XLSX.read(data, { type: 'array', cellDates:true }); // cellDates pour gérer les dates si besoin futur
                const firstSheetName = workbook.SheetNames[0];
                const worksheet = workbook.Sheets[firstSheetName];
                // Convertir en JSON, header:1 pour array d'arrays, defval pour cellules vides
                const sheetData = XLSX.utils.sheet_to_json(worksheet, { header: 1, defval: "" });

                if (sheetData.length < 2) { // Au moins une ligne d'en-tête et une ligne de données
                    showToast("Fichier Excel vide ou sans données après entête.", "error"); return;
                }

                const headers = sheetData[0].map(header => String(header).trim().toUpperCase());
                const colMapping = { // Mapping des noms de colonnes possibles vers les clés de l'objet OF
                    orderNumber: ['NUMERO OF', 'N° OF', 'NUMÉRO D\'ORDRE', 'ORDER NUMBER', 'OF'],
                    machine: ['MACHINE'],
                    product: ['PRODUIT', 'REFERENCE', 'RÉFÉRENCE', 'ARTICLE', 'DESIGNATION'],
                    quantity: ['QUANTITE PREVUE', 'QTÉ PRÉVUE', 'QUANTITÉ PRÉVUE', 'QTE PREVUE', 'PREVU', 'PRÉVU'],
                    produced: ['QUANTITE PRODUITE', 'QTÉ PRODUITE', 'PRODUITE', 'QTE PRODUITE', 'RÉALISÉ', 'REALISE'],
                    rebuts: ['REBUTS', 'QTÉ REBUTÉE', 'REBUT', 'NB REBUT']
                };
                const headerIndices = {}; // Pour stocker les indices des colonnes trouvées
                for (const key in colMapping) {
                    headerIndices[key] = -1; // Initialiser à -1 (non trouvé)
                    for (const alias of colMapping[key]) {
                        const index = headers.indexOf(alias.toUpperCase());
                        if (index !== -1) { headerIndices[key] = index; break; } // Garder le premier alias trouvé
                    }
                }

                // Vérifier que les colonnes minimales sont présentes
                if (headerIndices.orderNumber === -1 || headerIndices.quantity === -1) {
                    showToast("Colonnes 'Numéro OF' et 'Quantité Prévue' sont obligatoires dans le fichier Excel.", "error");
                    return;
                }

                let newOFsAddedCount = 0; const importedOFs = [];
                for (let i = 1; i < sheetData.length; i++) { // Commencer après la ligne d'en-tête
                    const row = sheetData[i];
                    const orderNumberStr = String(row[headerIndices.orderNumber] || '').trim();
                    if (!orderNumberStr) continue; // Ignorer si pas de numéro d'OF

                    const quantityVal = parseInt(row[headerIndices.quantity], 10);
                    if (isNaN(quantityVal) || quantityVal <= 0) { showToast(`Qté prévue invalide pour OF ${orderNumberStr} (ligne ${i+1}). Ignoré.`, "warning"); continue; }
                    
                    const producedVal = headerIndices.produced !== -1 ? parseInt(row[headerIndices.produced], 10) : 0;
                    const rebutsVal = headerIndices.rebuts !== -1 ? parseInt(row[headerIndices.rebuts], 10) : 0;

                    const newOF = {
                        id: Date.now().toString() + "_" + Math.random().toString(36).substr(2, 5),
                        orderNumber: orderNumberStr,
                        machine: headerIndices.machine !== -1 ? String(row[headerIndices.machine] || '').trim() : 'N/A',
                        product: headerIndices.product !== -1 ? String(row[headerIndices.product] || '').trim() : 'N/A',
                        quantity: quantityVal,
                        produced: !isNaN(producedVal) ? producedVal : 0,
                        rebuts: !isNaN(rebutsVal) ? rebutsVal : 0,
                        status: 'Planifié' // Statut par défaut
                    };
                    // Ajuster le statut basé sur les quantités importées
                    const qteBonne = newOF.produced - newOF.rebuts;
                    if (qteBonne >= newOF.quantity) newOF.status = 'Terminé';
                    else if (newOF.produced > 0) newOF.status = 'En cours';
                    
                    importedOFs.push(newOF); newOFsAddedCount++;
                }

                if (newOFsAddedCount > 0) {
                    ofsData.push(...importedOFs); // Ajouter les nouveaux OFs aux données existantes
                    saveOFs(); renderOFsTable(); updateOFsSummary(); updateOFStatusChart(); updateGlobalStatsBar();
                    showToast(`${newOFsAddedCount} OF(s) importé(s) avec succès.`, "success");
                } else { showToast("Aucun nouvel OF valide trouvé dans le fichier.", "info"); }

            } catch (err) { console.error("Erreur lecture Excel OFs:", err); showToast("Erreur lecture Excel: " + err.message, "error"); }
            finally { event.target.value = null; } // Permettre de réimporter le même fichier
        };
        reader.onerror = function(ex) { console.log(ex); showToast("Erreur lecture fichier.", "error"); event.target.value = null; };
        reader.readAsArrayBuffer(file); // Lire comme ArrayBuffer pour xlsx.js
    }

