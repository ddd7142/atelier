    function printCongesSemaineCourantePDF() { const today=new Date();const year=today.getFullYear();const weekNum=getISOWeek(today);const startW=getStartOfWeek(year,weekNum);startW.setHours(0,0,0,0);const endW=new Date(startW); endW.setDate(startW.getDate()+6); endW.setHours(23,59,59,999); const allConges=loadConges();const congesW=allConges.filter(c=>{const sD=new Date(c.dateDebut);sD.setHours(0,0,0,0);const eD=new Date(c.dateFin);eD.setHours(23,59,59,999);return sD<=endW&&eD>=startW;});const {jsPDF}=window.jspdf;const doc=new jsPDF();doc.text(`Congés Semaine ${weekNum} (${year})`,10,15);doc.setFontSize(10);doc.text(`(Du ${formatDate(startW)} au ${formatDate(endW)})`,10,20);if(congesW.length===0)doc.text("Aucun congé cette semaine.",10,30);else{const rows=congesW.map(c=>{let jrs=0;if(c.typeConge==="Congé"){let cur=new Date(Math.max(new Date(c.dateDebut),startW));let endEff=new Date(Math.min(new Date(c.dateFin),endW));while(cur<=endEff){const dayW=cur.getDay();if(dayW!==0&&dayW!==6&&!isHoliday(cur))jrs++;cur.setDate(cur.getDate()+1);}}return[c.collaborateur,c.typeConge,formatDate(c.dateDebut),formatDate(c.dateFin),(c.typeConge==="Congé")?jrs:'-'];});doc.autoTable({head:[['Collaborateur','Type','Début','Fin','Jrs Ouvrés (Sem.)']],body:rows,startY:25,headStyles:{fillColor:getCssVar('--primary-color'),textColor:getCssVar('--text-light-color')},alternateRowStyles:{fillColor:'#f5f5f5'}});}doc.save(`conges_semaine_${weekNum}_${year}.pdf`); showToast(`PDF des congés semaine ${weekNum} généré.`, "success");}
    function genererCalendrierMoisActuel(targetDivId,containerDivId){const calDiv=document.getElementById(targetDivId);const calCont=document.getElementById(containerDivId);if(!calDiv||!calCont)return;calDiv.innerHTML='';const today=new Date();const curM=today.getMonth();const curY=today.getFullYear();const curDay=today.getDate();const curW=getISOWeek(today);const moisNoms=["Janv","Fév","Mars","Avr","Mai","Juin","Juil","Août","Sept","Oct","Nov","Déc"];const joursNoms=["Lu","Ma","Me","Je","Ve","Sa","Di"];const titre=calCont.querySelector('h4');if(titre)titre.textContent=`${moisNoms[curM]} ${curY} (S.ISO:${curW})`;const table=document.createElement('table');table.className='calendrier-table';const head=table.createTHead();const hr=head.insertRow();joursNoms.forEach(j=>{const th=document.createElement('th');th.textContent=j;hr.appendChild(th);});const body=table.createTBody();const firstD=new Date(curY,curM,1);const daysIM=new Date(curY,curM+1,0).getDate();let startD=firstD.getDay();startD=(startD===0)?6:startD-1;let dateNum=1;for(let i=0;i<6;i++){const r=body.insertRow();let rHNC=false;for(let j=0;j<7;j++){const cell=r.insertCell();if(i===0&&j<startD)cell.classList.add('calendrier-jour-vide');else if(dateNum>daysIM)cell.classList.add('calendrier-jour-vide');else{cell.textContent=dateNum;const cDO=new Date(curY,curM,dateNum);if(dateNum===curDay&&curM===today.getMonth()&&curY===today.getFullYear())cell.classList.add('calendrier-jour-actuel');if(getISOWeek(cDO)===curW&&curY===today.getFullYear()&&!cell.classList.contains('calendrier-jour-actuel'))cell.classList.add('calendrier-semaine-actuelle');if(isHoliday(cDO)){cell.classList.add('calendrier-jour-ferie');cell.title=isHoliday(cDO);}if(j===5||j===6)cell.classList.add('calendrier-jour-weekend');dateNum++;rHNC=true;}}if(!rHNC&&dateNum>daysIM)r.style.display='none';}calDiv.appendChild(table);}
    
    // MODIFICATION/AJOUT START: Fonction pour actualiser les droits CP annuels
    function promptForAnnualCPUpdate() {
        if (!isAdminMode) {
            showToast("Mode Administrateur requis.", "warning");
            return;
        }

        const defaultDays = 25; // Nombre de jours ouvrés typiquement acquis par an en France
        const acquiredDaysInput = prompt(`Entrez le nombre de jours de CP nouvellement acquis pour la période de référence terminée (ex: ${defaultDays}) :\nCette valeur sera définie comme "Jours Acquis Initiaux" pour tous.`, defaultDays.toString());

        if (acquiredDaysInput === null) { // Utilisateur a annulé
            return;
        }

        const acquiredDays = parseInt(acquiredDaysInput, 10);
        if (isNaN(acquiredDays) || acquiredDays < 0 || acquiredDays > 60) { // Validation simple (0-60 jours)
            showToast("Nombre de jours invalide. Veuillez entrer un nombre entre 0 et 60.", "error");
            return;
        }

        if (!confirm(`CONFIRMER : Voulez-vous définir les "Jours Acquis Initiaux" à ${acquiredDays} jours pour TOUS les collaborateurs ?\n\nCeci écrasera leurs valeurs actuelles de "Jrs Acquis Init.".\nLes jours de congé déjà pris (type "Congé Décompté") seront ensuite déduits de ce nouveau total pour calculer le solde restant.`)) {
            return;
        }

        let joursAcquisData = loadJoursAcquis(); // Charger les données actuelles pour s'assurer que la structure est complète
        
        const tousLesCollaborateurs = new Set();
        // S'assurer de prendre tous les collaborateurs connus
        Object.values(equipes).forEach(e => e.forEach(c => tousLesCollaborateurs.add(c)));
        document.querySelectorAll('#collaborateur option').forEach(o => { if (o.value) tousLesCollaborateurs.add(o.value); });
        Object.keys(joursAcquisData).forEach(c => tousLesCollaborateurs.add(c)); // Important: inclure ceux qui sont uniquement dans joursAcquisData

        let updatedCount = 0;
        tousLesCollaborateurs.forEach(collaborateur => {
            joursAcquisData[collaborateur] = acquiredDays; // Met à jour ou ajoute le collaborateur avec le nouveau nombre de jours
            updatedCount++;
        });

        saveJoursAcquis(joursAcquisData); // Sauvegarder les modifications
        
        // Rafraîchir les affichages
        displayGestionSoldesTable(); 
        updateSoldeCollaborateurDisplay(); 
        
        showToast(`${updatedCount} collaborateur(s) mis à jour avec ${acquiredDays} jours acquis initiaux.`, "success");
        
        // Rafraîchir le planning si cette section est active, car les congés affectent la disponibilité
        if (document.getElementById('planning') && document.getElementById('planning').classList.contains('active')) {
            renderPlanningForWeek();
        }
    }
