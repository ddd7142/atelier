    function calculateAndDisplayProductionAverages() {
        const averageTableBody = document.getElementById('production-average-table')?.querySelector('tbody');
        if (!averageTableBody) return;

        averageTableBody.innerHTML = ''; // Vider le tableau des moyennes

        const allReferences = Object.keys(DEFAULT_PRODUCT_DEFINITIONS_PROD); // Utiliser la définition par défaut comme liste maître des références
        const productionSums = {}; // { "Référence": { total: 0, weeks: 0 } }

        // Initialiser productionSums pour toutes les références
        allReferences.forEach(ref => {
            productionSums[ref] = { total: 0, weeks: 0 };
        });

        // Parcourir toutes les données de production stockées dans localStorage
        for (let i = 0; i < localStorage.length; i++) {
            const key = localStorage.key(i);
            if (key.startsWith('atelier_prodData_')) { // C'est une clé de données de production
                try {
                    const weeklyData = JSON.parse(localStorage.getItem(key));
                    for (const ref in weeklyData) {
                        if (productionSums[ref]) { // Si la référence est connue
                            const weekTotal = weeklyData[ref].reduce((acc, val) => acc + (Number(val) || 0), 0);
                            if (weekTotal > 0 || weeklyData[ref].some(dayVal => dayVal !== 0)) { // Compter la semaine seulement si il y a eu de la production ou une saisie (même 0)
                                productionSums[ref].total += weekTotal;
                                productionSums[ref].weeks++;
                            }
                        }
                    }
                } catch (e) {
                    console.warn(`Erreur de parsing des données pour la clé ${key}:`, e);
                }
            }
        }

        // Remplir le tableau des moyennes
        if (allReferences.length === 0) {
            const row = averageTableBody.insertRow();
            const cell = row.insertCell();
            cell.colSpan = 3;
            cell.textContent = "Aucune référence produit définie pour calculer les moyennes.";
            cell.style.textAlign = "center";
        } else {
            allReferences.forEach(ref => {
                const data = productionSums[ref];
                const average = data.weeks > 0 ? (data.total / data.weeks).toFixed(2) : "0.00";
                
                const row = averageTableBody.insertRow();
                row.insertCell().textContent = ref;
                row.insertCell().textContent = average;
                row.insertCell().textContent = data.weeks;
            });
        }
    }

