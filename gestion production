                if (dIP > 0) { if (!tBT[c.typeConge]) tBT[c.typeConge] = 0; tBT[c.typeConge] += dIP; if (!tBC[c.collaborateur]) tBC[c.collaborateur] = 0; tBC[c.collaborateur] += dIP;}} } });
