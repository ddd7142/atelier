    function handleProductionExcelImport(event) {
        if (!isAdminMode) { showToast("Mode Administrateur requis.", "warning"); return; }
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(e_reader){
            const data = e_reader.target.result;
            try{
                const workbook = XLSX.read(data,{type:'array'});
                const firstSheetName = workbook.SheetNames[0];
                const worksheet = workbook.Sheets[firstSheetName];
                const sheetData = XLSX.utils.sheet_to_json(worksheet,{header:1,defval:""});

                if(sheetData.length<1){showToast("Fichier Excel vide/mal formaté.", "error");return;}

                loadObjectivesForWeek_prod(currentProductionYear,currentProductionWeekNum); // S'assurer que les objectifs sont à jour

                let tempProductionData = JSON.parse(JSON.stringify(productionData_prod)); // Copie profonde pour modifications

                // Si tempProductionData est vide ou ne contient pas tous les produits des objectifs, l'initialiser
                if(Object.keys(tempProductionData).length===0 || !Object.keys(currentWeekObjectives_prod).every(k=>tempProductionData[k])){
                    tempProductionData={};
                    for(const ref in currentWeekObjectives_prod) tempProductionData[ref]=Array(7).fill(0);
                }

                let importSuccessful=false;
                for(let i=1; i<sheetData.length; i++){ // Commencer à la deuxième ligne (après les en-têtes)
                    const row = sheetData[i];
                    if(!row || row.length === 0 || !row[0]) continue; // Ignorer lignes vides ou sans nom de produit

                    const productName = String(row[0]).trim(); // Nom du produit dans la première colonne

                    if(currentWeekObjectives_prod[productName]){ // Si le produit existe dans nos définitions d'objectifs
                        if(!tempProductionData[productName]) tempProductionData[productName]=Array(7).fill(0); // S'assurer que le tableau existe

                        for(let dayIndex=0; dayIndex<7; dayIndex++){ // Pour les 7 jours
                            const cellValue = row[dayIndex+1]; // Colonnes B à H pour les jours Dim à Sam
                            const numericValue = parseFloat(cellValue);
                            tempProductionData[productName][dayIndex] = !isNaN(numericValue) ? numericValue : 0;
                        }
                        importSuccessful=true;
                    } else {
                        console.warn(`Produit Excel "${productName}" non trouvé dans les définitions d'objectifs. Ligne ignorée.`);
                    }
                }

                if(importSuccessful){
                    productionData_prod = tempProductionData; // Mettre à jour les données de production globales
                    createProductionTable_prod(); // Rafraîchir le tableau HTML
                    updateProductionChart_prod(); // Rafraîchir le graphique
                    updateResultCards_prod(); // Rafraîchir les cartes de résultats
                    showToast(`Données importées d'Excel pour S${currentProductionWeekNum}. N'oubliez pas de SAUVEGARDER.`, "success");
                } else {
                    showToast("Aucune donnée correspondante importée. Vérifiez le format du fichier.", "warning");
                }
            } catch(err) {
                console.error("Erreur lecture Excel prod:", err);
                showToast("Erreur lecture Excel: " + err.message, "error");
            } finally {
                event.target.value = null; // Réinitialiser le champ fichier pour permettre réimportation du même fichier
            }
        };
        reader.onerror = function(ex){
            console.log(ex);
            showToast("Erreur de lecture du fichier.", "error");
            event.target.value = null;
        };
        reader.readAsArrayBuffer(file);
    }
    
