        while (currentDate <= endDate) { const dayOfWeek = currentDate.getDay(); if (dayOfWeek !== 0 && dayOfWeek !== 6 && !isHoliday(currentDate)) count++; currentDate.setDate(currentDate.getDate() + 1); } return count;
